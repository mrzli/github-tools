{
  "name": "@gmjs/github-cli",
  "version": "0.0.1",
  "description": "github-cli",
  "author": {
    "name": "Goran Mržljak",
    "email": "goran.mrzljak@gmail.com",
    "url": "https://mrzli.com"
  },
  "license": "MIT",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/mrzli/github-cli"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
    "gmgh": "dist/index.js"
  },
  "scripts": {
    "dev": "bun src/_local/run.ts",
    "dev:watch": "bun --watch src/_local/run.ts",
    "devl": "bun src/index.ts",
    "test": "bun test",
    "test+": "bun run test",
    "clean": "rm -rf ./dist",
    "build": "bun run clean && bun build src/index.ts --outdir dist --target node --format cjs",
    "build+": "bun run test+ && bun run build"
  },
  "dependencies": {
    "@gmjs/apply-function": "^0.0.3",
    "@gmjs/array-transformers": "^0.0.3",
    "@gmjs/assert": "^0.0.6",
    "@gmjs/comparers": "^0.0.1",
    "@gmjs/data-container-util": "^0.0.1",
    "@gmjs/file-system": "^0.0.3",
    "@gmjs/number-util": "^0.0.3",
    "@gmjs/package-json": "^0.0.2",
    "@gmjs/repo-list": "workspace:^",
    "@gmjs/value-transformers": "^0.0.15",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "tslib": "^2.6.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22.3.0"
  }
}
